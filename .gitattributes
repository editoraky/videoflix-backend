# Das Entrypoint-Script wird im Linux-Container ausgefuehrt.
# Mit CRLF-Zeilenenden schlaegt der Start mit
# "exec ./backend.entrypoint.sh: no such file or directory" fehl,
# weil der Shebang dann auf "/bin/sh\r" zeigt.
*.sh text eol=lf
backend.entrypoint.sh text eol=lf

# Aus demselben Grund fuer die uebrigen Container-Dateien.
*.Dockerfile text eol=lf
docker-compose.yml text eol=lf
