# The entrypoint script runs inside the Linux container. With CRLF line endings
# the start fails with
# "exec ./backend.entrypoint.sh: no such file or directory",
# because the shebang then points at "/bin/sh\r".
*.sh text eol=lf
backend.entrypoint.sh text eol=lf

# Same reason for the remaining container files.
*.Dockerfile text eol=lf
docker-compose.yml text eol=lf
